PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://username:password@localhost:5432/database_name?schema=public"

# ── JWT Secrets (use separate secrets per token type) ─────────────────────────
# Legacy admin token (existing system — keep this unchanged for backward compat)
JWT_SECRET="your_legacy_jwt_secret"

# ISP tenant tokens (app.deroyalhotspot.name.ng)
ISP_JWT_SECRET="your_isp_jwt_secret_min_32_chars"

# Super Admin tokens (platform.deroyalhotspot.name.ng)
PLATFORM_JWT_SECRET="your_platform_jwt_secret_min_32_chars"

# Customer account tokens (account.deroyalhotspot.name.ng)
CUSTOMER_JWT_SECRET="your_customer_jwt_secret_min_32_chars"

# ── MikroTik RouterOS API ─────────────────────────────────────────────────────
MIKROTIK_HOST="192.168.88.1"
MIKROTIK_PORT=8728
MIKROTIK_USERNAME="admin"
MIKROTIK_PASSWORD="admin"
MIKROTIK_TIMEOUT=5000
# Set to "true" for local dev without a physical router (skips real RouterOS calls)
MIKROTIK_SIMULATION_MODE="false"

# ── Application URLs ──────────────────────────────────────────────────────────
APP_URL="http://localhost:5173"
API_URL="http://localhost:5000/api/v1"

# Production subdomains (set NODE_ENV=production and update these)
# CORS_ORIGINS="https://deroyalhotspot.name.ng,https://app.deroyalhotspot.name.ng,https://platform.deroyalhotspot.name.ng,https://account.deroyalhotspot.name.ng"

