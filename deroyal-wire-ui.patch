@@ -148,3 +151,91 @@ html {
 .animate-scale-in { animation: scale-in 0.3s ease-out forwards; }
 .animate-float    { animation: float 4s ease-in-out infinite; }
 .animate-pulse-glow { animation: pulse-glow 2s ease-in-out infinite; }
+
+
+/* ═══════════════════════════════════════════════════════════════════
+   Console design system — dashboards, admin screens, forms
+   One orange action, four wire hues for meaning, navy for structure.
+   ═══════════════════════════════════════════════════════════════════ */
+
+/* ── Canvas: soft wire-tinted wash behind every console page ───────── */
+@layer base {
+  body {
+    @apply bg-white text-navy-900 dark:bg-navy-950 dark:text-slate-100;
+  }
+  :focus-visible {
+    outline: 2px solid #3B82F6;
+    outline-offset: 2px;
+    border-radius: 6px;
+  }
+  @media (prefers-reduced-motion: reduce) {
+    *, *::before, *::after {
+      animation-duration: 0.01ms !important;
+      animation-iteration-count: 1 !important;
+      transition-duration: 0.01ms !important;
+      scroll-behavior: auto !important;
+    }
+  }
+}
+
+@layer components {
+  .console-canvas {
+    background-color: #F6F8FC;
+    background-image:
+      radial-gradient(60rem 28rem at 0% -8%,  rgba(249,115,22,0.09), transparent 60%),
+      radial-gradient(52rem 30rem at 100% -4%, rgba(59,130,246,0.10), transparent 60%),
+      radial-gradient(46rem 26rem at 100% 108%, rgba(34,197,94,0.06), transparent 60%);
+    background-attachment: fixed;
+  }
+  .dark .console-canvas {
+    background-color: #070E24;
+    background-image:
+      radial-gradient(60rem 28rem at 0% -8%,  rgba(249,115,22,0.10), transparent 60%),
+      radial-gradient(52rem 30rem at 100% -4%, rgba(59,130,246,0.14), transparent 60%),
+      radial-gradient(46rem 26rem at 100% 108%, rgba(34,197,94,0.07), transparent 60%);
+  }
+
+  /* ── Panels (frosted cards) ─────────────────────────────────────── */
+  .panel {
+    @apply rounded-card border border-slate-200/80 bg-white/85 shadow-panel backdrop-blur-sm
+           dark:border-white/10 dark:bg-navy-900/70;
+  }
+  .panel-hover {
+    @apply transition-shadow duration-200 hover:shadow-panel-lift;
+  }
+
+  /* ── Buttons ────────────────────────────────────────────────────── */
+  .btn {
+    @apply inline-flex min-h-[40px] items-center justify-center gap-2 rounded-button px-4 text-sm font-bold
+           transition-colors disabled:cursor-not-allowed disabled:opacity-50;
+  }
+  /* Navy text on orange: 6.5:1 contrast. White on #F97316 is only 2.8:1. */
+  .btn-primary   { @apply btn bg-wire-orange text-navy-950 hover:bg-wire-orange-dark hover:text-white; }
+  .btn-secondary { @apply btn border border-slate-200 bg-white text-navy-900 hover:border-wire-blue hover:text-wire-blue-dark
+                          dark:border-white/15 dark:bg-white/5 dark:text-white dark:hover:border-wire-blue dark:hover:text-wire-blue; }
+  .btn-ghost     { @apply btn text-slate-600 hover:bg-slate-100 dark:text-slate-300 dark:hover:bg-white/10; }
+  .btn-danger    { @apply btn bg-red-600 text-white hover:bg-red-700; }
+
+  /* ── Form controls ──────────────────────────────────────────────── */
+  .input {
+    @apply min-h-[44px] w-full rounded-button border border-slate-200 bg-white px-3.5 text-sm text-navy-900
+           placeholder:text-slate-400 focus:border-wire-blue focus:outline-none focus:ring-2 focus:ring-wire-blue/30
+           dark:border-white/15 dark:bg-navy-950/60 dark:text-white;
+  }
+  .label {
+    @apply mb-1.5 block text-xs font-semibold text-slate-600 dark:text-slate-300;
+  }
+
+  /* ── Status pills: colour always paired with a word, never colour alone ── */
+  .pill        { @apply inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-semibold; }
+  .pill-green  { @apply pill bg-wire-green/15 text-wire-green-dark dark:text-wire-green; }
+  .pill-orange { @apply pill bg-wire-orange/15 text-wire-orange-dark dark:text-wire-orange; }
+  .pill-blue   { @apply pill bg-wire-blue/15 text-wire-blue-dark dark:text-wire-blue; }
+  .pill-brown  { @apply pill bg-wire-brown/15 text-wire-brown dark:text-wire-brown-light; }
+  .pill-red    { @apply pill bg-red-500/10 text-red-700 dark:text-red-400; }
+  .pill-slate  { @apply pill bg-slate-500/10 text-slate-600 dark:text-slate-300; }
+
+  /* ── Tables ─────────────────────────────────────────────────────── */
+  .table-head { @apply bg-slate-50 text-left text-xs font-semibold text-slate-500 dark:bg-white/5 dark:text-slate-400; }
+  .table-row  { @apply border-t border-slate-100 transition-colors hover:bg-slate-50/70 dark:border-white/5 dark:hover:bg-white/5; }
+}
